{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "comment": "Weekly credit-card reminder. Reads the recipients from a named table in an Excel file on OneDrive, then sends one separate email per row. Runs in the Microsoft cloud - laptop/Outlook do NOT need to be on.",
  "parameters": {
    "$connections": { "type": "Object", "defaultValue": {} },
    "$authentication": { "type": "SecureObject", "defaultValue": {} }
  },
  "triggers": {
    "Every_Monday_10_AM": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Week",
        "interval": 1,
        "schedule": {
          "weekDays": [ "Monday" ],
          "hours": [ "10" ],
          "minutes": [ 0 ]
        },
        "timeZone": "India Standard Time",
        "startTime": "2026-09-21T10:00:00Z"
      },
      "metadata": {
        "note": "Change timeZone to your own (e.g. 'GMT Standard Time', 'Eastern Standard Time'). The Recurrence card's Time zone field must be set, otherwise the schedule runs in UTC."
      }
    }
  },
  "actions": {
    "List_rows_present_in_a_table": {
      "type": "OpenApiConnection",
      "runAfter": {},
      "metadata": {
        "note": "Pick Location / Document Library / File / Table from the dropdowns in the designer - the ids below are filled in for you. The table must be a NAMED Excel table ('Recipients'), not a plain sheet.",
        "filter": "Remove the $filter line if you do not use an Active column."
      },
      "inputs": {
        "host": {
          "connectionName": "shared_excelonlinebusiness",
          "operationId": "GetItems",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness"
        },
        "parameters": {
          "source": "me",
          "drive": "<OneDrive id - chosen from the Document Library dropdown>",
          "file": "<file id - chosen from the File dropdown, /Automation/recipients.xlsx>",
          "table": "Recipients",
          "$filter": "Active eq 'Yes'"
        },
        "authentication": "@parameters('$authentication')"
      },
      "runtimeConfiguration": {
        "paginationPolicy": { "minimumItemCount": 5000 }
      }
    },
    "Send_one_email_per_person": {
      "type": "Foreach",
      "foreach": "@body('List_rows_present_in_a_table')?['value']",
      "runAfter": { "List_rows_present_in_a_table": [ "Succeeded" ] },
      "runtimeConfiguration": {
        "concurrency": { "repetitions": 1 }
      },
      "actions": {
        "Send_an_email_(V2)": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "metadata": {
            "note": "'Name' and 'Email' must match the Excel header row exactly, including case."
          },
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/To": "@items('Send_one_email_per_person')?['Email']",
              "emailMessage/Subject": "@concat('Apply credit card - ', items('Send_one_email_per_person')?['Name'])",
              "emailMessage/Body": "<p>Dear @{items('Send_one_email_per_person')?['Name']},</p><p>Please note you didn't applied credit card yet, Please apply.</p><p>Thanks<br>Rakhi</p>",
              "emailMessage/Importance": "Normal"
            },
            "authentication": "@parameters('$authentication')",
            "retryPolicy": {
              "type": "exponential",
              "count": 4,
              "interval": "PT20S"
            }
          }
        }
      }
    }
  },
  "outputs": {}
}
